# ============================================================
# Top25 Talent — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ---- Supabase -----------------------------------------------
# Found at: supabase.com → Your Project → Settings → API
# Safe to expose in browser (prefixed NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# SERVICE ROLE KEY — ⚠️ NEVER expose this to the browser.
# Used only in server-side code (API routes, server actions).
# Found at: supabase.com → Your Project → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---- Stripe -------------------------------------------------
# Found at: dashboard.stripe.com → Developers → API keys
# Use TEST mode keys during development (start with sk_test_ / pk_test_)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here

# Webhook signing secret — ensures webhook events come from Stripe
# For LOCAL dev: run `stripe listen --forward-to localhost:3000/api/stripe/webhook`
#   and copy the printed whsec_... value here.
# For PRODUCTION: create a webhook endpoint in the Stripe dashboard pointing
#   to https://your-domain.vercel.app/api/stripe/webhook and copy the signing secret.
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# Optional: public Stripe publishable key (not currently used server-side, but handy)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key-here

# ---- Site ---------------------------------------------------
# For local dev: http://localhost:3000
# For production: your Vercel URL (e.g. https://top25-talent.vercel.app)
# Used for auth redirects and absolute URL generation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
